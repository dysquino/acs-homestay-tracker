# ACs Homestay Tracker — environment variables. Copy to .env.local and fill
# in; never commit real values. Same variables, in the same order, as
# .env.local. Each section says where else it has to be set.

# ── Database (Neon) ─────────────────────────────────────────────────────
# Pooled connection (Neon host containing "-pooler") — used by the app at
# runtime. Also set in Vercel. Plain local Postgres works too.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same host without "-pooler") — used only by
# `npm run db:push` / migrations. Also set in Vercel. For plain local
# Postgres, the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ── Supabase (not used yet) ─────────────────────────────────────────────
# Only src/lib/supabase.ts reads these, and nothing uses it yet. Kept for the
# planned per-person logins.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service-role key, for admin-level auth operations later (server-only).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Site access gate ────────────────────────────────────────────────────
# Shared access code (src/proxy.ts) — NOT per-user auth. Required in Vercel:
# a production deployment without it refuses every request. Leave unset
# locally: the gate is then a no-op, so local dev never asks for it.
SITE_PASSWORD="choose-a-password"

# ── Guests' booking link ────────────────────────────────────────────────
# Secret in /book?k=... Any long random text, e.g. `openssl rand -hex 16`.
# Set in Vercel; changing it disables old links. If unset, the booking page
# says "link not valid" for everyone.
BOOKING_LINK_KEY="choose-a-long-random-string"

# ── Airbnb calendar sync ────────────────────────────────────────────────
# Airbnb → app: the listing's calendar link (Airbnb → listing → Availability
# → Connect calendars → Export calendar). Its reservations block direct
# bookings. Private: anyone with it can read the calendar. Also in Vercel;
# leave unset to switch the sync off.
AIRBNB_ICAL_URL="https://www.airbnb.com/calendar/ical/....ics"
# App → Airbnb: secret in the direct-bookings feed link Airbnb imports
# (/api/calendar/<key>.ics). Any long random text. Also in Vercel; changing
# it disables the old link (update it in Airbnb's "Import calendar" too).
CALENDAR_FEED_KEY="choose-a-long-random-string"

# ── Backups (local tools + GitHub Actions) ──────────────────────────────
# The site's access code, for the backup-live-data skill. Same value as
# SITE_PASSWORD in Vercel; also a GitHub Actions secret (daily backup).
BACKUP_SITE_PASSWORD="same-as-site-password"
# Encrypts the nightly GitHub backups and decrypts them locally
# (backup-crypto.mjs). Any long random text, e.g. `openssl rand -base64 32`.
# Also a GitHub Actions secret. Keep a copy in a password manager — without
# it the backups can't be opened.
BACKUP_ENCRYPTION_KEY="choose-a-long-random-string"

# ── Reconciliation (kill switch) ────────────────────────────────────────
# Master switch for the reconciliation workspace: the financial-event tables
# (booking payments, expense settlements) and every write action behind them.
# Fails closed — leave it unset or set it to anything other than "true" and the
# feature refuses writes. Set "true" to enable. Flip it and redeploy to disable
# the feature without a code change (see src/lib/reconciliation-flag.ts).
# NOTE: the tables must also exist in the database (prisma db push) before
# enabling, or the enabled actions will error on a missing table.
RECONCILIATION_ENABLED="true"
