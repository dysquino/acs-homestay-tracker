# Runtime connection (Supabase: use the transaction pooler, port 6543, with
# ?pgbouncer=true — the direct connection host is IPv6-only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acs_homestay_tracker"
# Used only for `prisma db push`/migrations (Supabase: session pooler, port
# 5432, same host as above). Can be the same as DATABASE_URL for plain
# local Postgres.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/acs_homestay_tracker"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Site-wide access gate (src/proxy.ts) — NOT per-user auth, just a shared
# password to keep the public deployment from being wide open before real
# Supabase Auth is wired up. Required on the live Vercel deployment; if
# unset, the gate is a no-op (fine for local dev).
SITE_PASSWORD="choose-a-password"
