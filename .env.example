# Runtime connection (Supabase: use the transaction pooler, port 6543, with
# ?pgbouncer=true — the direct connection host is IPv6-only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acs_homestay_tracker"
# Used only for `prisma db push`/migrations (Supabase: session pooler, port
# 5432, same host as above). Can be the same as DATABASE_URL for plain
# local Postgres.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/acs_homestay_tracker"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Site-wide access gate (src/proxy.ts) — NOT per-user auth, just a shared
# password to keep the public deployment from being wide open before real
# Supabase Auth is wired up. Required on the live Vercel deployment; if
# unset, the gate is a no-op (fine for local dev).
SITE_PASSWORD="choose-a-password"

# Secret key in the guests' booking link (/book?k=...). Any long random
# string, e.g. `openssl rand -hex 16`. Changing it disables old links. If
# unset, the booking page shows "link not valid" for everyone.
BOOKING_LINK_KEY="choose-a-long-random-string"

# Airbnb calendar link (Airbnb → listing → Availability → Connect calendars →
# Export calendar). Its reservations block direct bookings. Private: anyone
# with it can read the calendar. Leave unset to switch the sync off.
AIRBNB_ICAL_URL="https://www.airbnb.com/calendar/ical/....ics"

# Secret key in the calendar feed of direct bookings that Airbnb imports
# (/api/calendar/<key>). Any long random string; changing it disables the
# old feed link (update it in Airbnb's "Import calendar" too).
CALENDAR_FEED_KEY="choose-a-long-random-string"
